{
  "name": "opencode-token-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Token/context efficiency plugin for OpenCode: metering, tool-output compression, dedupe, session rotation and model routing.",
  "exports": {
    ".": "./index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "index.ts",
    "src",
    "native",
    "dist"
  ],
  "scripts": {
    "postinstall": "node scripts/setup-native.mjs",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:gui": "vite build",
    "typecheck": "tsc --noEmit",
    "test:native": "cargo test --manifest-path native/Cargo.toml --release"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.19",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16"
  }
}
